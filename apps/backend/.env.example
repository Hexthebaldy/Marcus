MARCUS_ENVIRONMENT=development
MARCUS_DATABASE_URL=mysql+asyncmy://marcus:marcus-local-only@127.0.0.1:3307/marcus?charset=utf8mb4
MARCUS_REDIS_URL=redis://127.0.0.1:6380/0
MARCUS_SECRET_KEY=replace-with-a-random-signing-secret-at-least-32-characters
# Generate using: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MARCUS_ENCRYPTION_KEY=
MARCUS_WEB_ORIGINS=http://localhost:5173,http://localhost:8081
MARCUS_SMTP_HOST=127.0.0.1
MARCUS_SMTP_PORT=1025
MARCUS_SMTP_STARTTLS=false
MARCUS_MAIL_FROM=Marcus <login@marcus.local>
MARCUS_S3_ENDPOINT_URL=http://127.0.0.1:9000
MARCUS_S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
MARCUS_S3_ACCESS_KEY=marcus-local
MARCUS_S3_SECRET_KEY=marcus-local-storage-only
MARCUS_S3_BUCKET=marcus
MARCUS_S3_REGION=us-east-1
# All first-version content is manually approved by default.
MARCUS_AUTO_APPROVE_NOTES=false
